# === IvoirEdu - PRODUCTION ===
# Chargé par `vite build` (mode production) et SURCHARGE .env.
#
# ⚠️ Les variables VITE_* sont INLINÉES dans le bundle au moment du build.
#    Il n'y a AUCUNE configuration runtime : changer l'API = REBUILD obligatoire.
#    Renseigne VITE_API_URL ci-dessous AVANT de packager, sinon le build échoue
#    (le placeholder __SET_VITE_API_URL__ est volontairement invalide pour éviter
#    de livrer par erreur un package pointant vers localhost).

# URL publique de l'API de production, AVEC le préfixe /api/v1.
# Ex : https://api.ivoiredu.ci/api/v1
VITE_API_URL=__SET_VITE_API_URL__

# En production, le tenant est résolu par le sous-domaine (ecole.ivoiredu.ci).
# Ce fallback ne sert que sur localhost, il est donc laissé vide ici.
VITE_DEFAULT_TENANT_SCHEMA=

# Réservé aux tests E2E uniquement - toujours vide en production.
VITE_E2E_SCHEMA_NAME=

# Email de support IvoirEdu affiché dans la bannière de reversement en retard.
VITE_SUPPORT_EMAIL=support@ivoiredu.ci
