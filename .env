# === IvoirEdu — DÉVELOPPEMENT LOCAL ===
# Chargé par `vite` (dev) et `vite build` quand aucun .env.<mode> ne surcharge.
# Pour un package de production, voir .env.production (qui a priorité en mode prod).

# URL de base de l'API backend (inclut le préfixe /api/v1).
VITE_API_URL=http://localhost:3000/api/v1

# Schéma tenant envoyé via x-tenant-schema au login UNIQUEMENT sur localhost,
# avant résolution serveur. Hors localhost, le tenant est résolu par sous-domaine.
VITE_DEFAULT_TENANT_SCHEMA=school_sainte_marie

# Schéma réservé aux tests end-to-end Playwright. Laisser vide en dev.
VITE_E2E_SCHEMA_NAME=

# Email de support IvoirEdu affiché dans la bannière de reversement en retard.
VITE_SUPPORT_EMAIL=support@ivoiredu.ci

# Clé publique VAPID pour le Web Push (doit matcher VAPID_PUBLIC_KEY du backend)
VITE_VAPID_PUBLIC_KEY=BBOCk2gbo8mOkacxaE5-0rsA-XgQIesL2CSP87cNeW7oDPB1MHITTpabWwMsjfbW5Cvv4EbitnWXyT1iosbN1m4
